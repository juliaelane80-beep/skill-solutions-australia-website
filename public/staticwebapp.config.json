{
  "routes": [
    {
      "route": "/",
      "rewrite": "/index.html"
    },
    {
      "route": "/job-seekers",
      "rewrite": "/job-seekers.html"
    },
    {
      "route": "/employers",
      "rewrite": "/employers.html"
    },
    {
      "route": "/about",
      "rewrite": "/about.html"
    },
    {
      "route": "/contact",
      "rewrite": "/contact.html"
    },
    {
      "route": "/program",
      "redirect": "/job-seekers#internship",
      "statusCode": 301
    },
    {
      "route": "/career-accelerator",
      "redirect": "/job-seekers#coaching",
      "statusCode": 301
    },
    {
      "route": "/pricing",
      "redirect": "/job-seekers",
      "statusCode": 301
    },
    {
      "route": "/solutions",
      "redirect": "/job-seekers",
      "statusCode": 301
    },
    {
      "route": "/booking",
      "redirect": "/contact",
      "statusCode": 301
    },
    {
      "route": "/partnerships",
      "redirect": "/employers",
      "statusCode": 301
    },
    {
      "route": "/recruitment",
      "redirect": "/employers#recruitment",
      "statusCode": 301
    },
    {
      "route": "/sitemap",
      "redirect": "/",
      "statusCode": 301
    },
    {
      "route": "/api/*",
      "allowedRoles": [
        "anonymous"
      ]
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  },
  "mimeTypes": {
    ".webp": "image/webp"
  },
  "globalHeaders": {
    "content-security-policy": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
